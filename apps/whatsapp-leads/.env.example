# ---------- Servidor ----------
PORT=3000
# Usuário e senha do painel. Se ADMIN_PASSWORD ficar vazio, uma senha aleatória é gerada e mostrada no terminal.
ADMIN_USER=admin
ADMIN_PASSWORD=
# Onde os dados ficam salvos
DATA_FILE=./data/db.json

# ---------- WhatsApp Cloud API (Meta) ----------
# Deixe WHATSAPP_TOKEN vazio para rodar em modo simulação (nada é enviado de verdade).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
# Chave secreta do app (Configurações do app > Básico) — valida a assinatura dos webhooks
WHATSAPP_APP_SECRET=
# Texto qualquer que você define e repete no painel da Meta ao configurar o webhook
WHATSAPP_VERIFY_TOKEN=troque-este-token

# ---------- Captura de leads (formulários de sites) ----------
# Token exigido em POST /api/intake. Vazio = endpoint desativado.
INTAKE_TOKEN=
# Código de país usado quando o telefone vem sem DDI
DEFAULT_COUNTRY_CODE=55

# ---------- Mensagens automáticas ----------
# Modelo (template) aprovado na Meta enviado quando um lead com opt-in é cadastrado. Vazio = desativado.
WELCOME_TEMPLATE=
WELCOME_TEMPLATE_LANGUAGE=pt_BR
# Variáveis do modelo, separadas por "|". Use {nome}, {primeiro_nome}, {telefone}, {origem}
WELCOME_TEMPLATE_PARAMS={primeiro_nome}

# Follow-up para quem não respondeu. Vazio = desativado.
FOLLOWUP_TEMPLATE=
FOLLOWUP_TEMPLATE_LANGUAGE=pt_BR
FOLLOWUP_TEMPLATE_PARAMS={primeiro_nome}
# Horas sem resposta antes de cada follow-up
FOLLOWUP_AFTER_HOURS=24
# Máximo de follow-ups por lead
FOLLOWUP_MAX=2
# Janela de envio automático (hora local do servidor, 0-23)
FOLLOWUP_START_HOUR=9
FOLLOWUP_END_HOUR=19
# Fuso horário usado para a janela acima
TIMEZONE=America/Sao_Paulo

# Palavras que fazem o lead sair da lista (separadas por vírgula)
OPT_OUT_KEYWORDS=sair,parar,pare,stop,cancelar,descadastrar
OPT_OUT_REPLY=Tudo certo! Você não receberá mais mensagens automáticas nossas.

# Intervalo entre envios em massa (ms), para respeitar limites da API
SEND_INTERVAL_MS=1200
